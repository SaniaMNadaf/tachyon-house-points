# Copy to .env and edit. All optional.
PORT=3000
# Used only the first time, when there are no admin accounts yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Set to false to start with an empty leaderboard instead of sample points.
SEED_SAMPLE=true
# Use a different database file (for hosting with a persistent disk).
# DB_PATH=/var/data/tachyon.db
# NODE_ENV=production   (turns on Secure cookies; use it when served over HTTPS)
